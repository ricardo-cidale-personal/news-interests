---
interface Interest {
  id: string;
  label: string;
}

interface Source {
  id: string;
  name: string;
  color?: string;
}

interface Props {
  interests: Interest[];
  sources: Source[];
}

const { interests, sources } = Astro.props;
---

<nav class="filter-bar">
  <div class="filter-section">
    <span class="filter-label">Topics:</span>
    <div class="filter-chips" id="interest-filters">
      <button class="chip active" data-interest="all">All</button>
      {interests.map((interest) => (
        <button class="chip" data-interest={interest.id}>
          {interest.label}
        </button>
      ))}
    </div>
  </div>

  {sources.length > 1 && (
    <div class="filter-section">
      <span class="filter-label">Sources:</span>
      <div class="filter-chips" id="source-filters">
        <button class="chip active" data-source="all">All</button>
        {sources.map((source) => (
          <button 
            class="chip" 
            data-source={source.id}
            style={source.color ? `--source-color: ${source.color}` : ''}
          >
            {source.name}
          </button>
        ))}
      </div>
    </div>
  )}
</nav>

<style>
  .filter-bar {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .filter-section {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .filter-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    min-width: 60px;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    display: inline-block;
    padding: 0.4375rem 0.875rem;
    background: white;
    border: 1px solid #ddd;
    border-radius: 20px;
    font-family: inherit;
    font-size: 0.8125rem;
    color: #444;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .chip:hover {
    border-color: #999;
    background: #f5f5f5;
  }

  .chip.active {
    background: #1a1a1a;
    border-color: #1a1a1a;
    color: white;
  }

  .chip[data-source]:not([data-source="all"]).active {
    background: var(--source-color, #1a1a1a);
    border-color: var(--source-color, #1a1a1a);
  }

  @media (max-width: 600px) {
    .filter-section {
      flex-direction: column;
      align-items: flex-start;
    }

    .filter-label {
      margin-bottom: 0.25rem;
    }

    .chip {
      padding: 0.375rem 0.75rem;
      font-size: 0.75rem;
    }
  }
</style>
